{
  "version": "2.0",
  "machine_type": "delivery",
  "description": "所有任务类型共享的交付生命周期；具体阶段由 workflow profile 提供",
  "stage_policies": {
    "planning": {
      "fail_target": "FAILED",
      "reject_target": "$self"
    },
    "implementation": {
      "fail_target": "FAILED",
      "reject_target": "REWORK"
    },
    "quality": {
      "fail_target": "REWORK",
      "fail_max_target": "FAILED",
      "reject_target": "REWORK"
    }
  },
  "common_states": {
    "INIT": {
      "type": "system_action",
      "action": "create_project",
      "display": "初始化",
      "next_states": {"start": "$first_stage"}
    },
    "REWORK": {
      "type": "human_confirmation",
      "display": "等待选择回退层级",
      "next_states": {}
    },
    "ACCEPTANCE_PENDING": {
      "type": "human_confirmation",
      "display": "等待验收",
      "next_states": {
        "confirm": "MERGING",
        "retry": "ACCEPTANCE_PENDING",
        "reject": "REWORK",
        "ask_user": "ACCEPTANCE_INPUT_PENDING"
      }
    },
    "ACCEPTANCE_INPUT_PENDING": {
      "type": "human_input",
      "input_purpose": "acceptance_clarification",
      "display": "等待验收澄清",
      "next_states": {"answer": "ACCEPTANCE_PENDING"}
    },
    "MERGING": {
      "type": "system_action",
      "action": "git_commit_push",
      "display": "提交产物中",
      "next_states": {
        "complete": "COMPLETED",
        "fail": "FAILED"
      }
    },
    "COMPLETED": {"type": "terminal", "success": true, "display": "已完成"},
    "FAILED": {"type": "terminal", "success": false, "display": "失败"},
    "CANCELLED": {"type": "terminal", "success": false, "display": "已取消"},
    "PAUSED": {
      "type": "idle",
      "display": "已暂停",
      "next_states": {"resume": "<previous_state>"}
    }
  }
}
