{
  "task_type": "feature",
  "description": "新功能开发流程",
  "initial_state": "PLANNING_REQUIREMENTS",
  "states": {
    "INIT": {
      "type": "system_action",
      "action": "create_project",
      "display": "初始化",
      "next_states": {
        "start": "PLANNING_REQUIREMENTS"
      }
    },
    "PLANNING_REQUIREMENTS": {
      "type": "agent_execution",
      "agent": "planner",
      "stage": "requirements",
      "display": "需求分析中",
      "next_states": {
        "complete": "REQUIREMENT_CONFIRM_PENDING",
        "fail": "FAILED"
      }
    },
    "REQUIREMENT_CONFIRM_PENDING": {
      "type": "human_confirmation",
      "display": "等待确认需求",
      "next_states": {
        "confirm": "PLANNING_ARCHITECTURE",
        "reject": "PLANNING_REQUIREMENTS"
      }
    },
    "PLANNING_ARCHITECTURE": {
      "type": "agent_execution",
      "agent": "planner",
      "stage": "architecture",
      "display": "方案设计中",
      "next_states": {
        "complete": "ARCHITECTURE_CONFIRM_PENDING",
        "fail": "FAILED"
      }
    },
    "ARCHITECTURE_CONFIRM_PENDING": {
      "type": "human_confirmation",
      "display": "等待确认方案",
      "next_states": {
        "confirm": "PLANNING_SPECS",
        "reject": "PLANNING_ARCHITECTURE",
        "select_option": "PLANNING_ARCHITECTURE"
      }
    },
    "PLANNING_SPECS": {
      "type": "agent_execution",
      "agent": "planner",
      "stage": "specs",
      "display": "Spec 拆分中",
      "next_states": {
        "complete": "SPEC_CONFIRM_PENDING",
        "fail": "FAILED"
      }
    },
    "SPEC_CONFIRM_PENDING": {
      "type": "human_confirmation",
      "display": "等待确认 Spec",
      "next_states": {
        "confirm": "CODING",
        "reject": "PLANNING_SPECS"
      }
    },
    "CODING": {
      "type": "agent_execution",
      "agent": "coder",
      "display": "编码中",
      "next_states": {
        "complete": "TESTING",
        "fail": "FAILED",
        "clarify": "CLARIFICATION_PENDING",
        "conflict": "CONFLICT_PENDING",
        "new_requirement": "PLANNING_REQUIREMENTS",
        "architecture_question": "PLANNING_ARCHITECTURE",
        "spec_question": "PLANNING_SPECS"
      }
    },
    "CLARIFICATION_PENDING": {
      "type": "human_input",
      "input_purpose": "clarification",
      "display": "等待澄清",
      "next_states": {
        "answer": "CODING",
        "needs_spec_change": "PLANNING_SPECS",
        "needs_architecture_change": "PLANNING_ARCHITECTURE"
      }
    },
    "CONFLICT_PENDING": {
      "type": "human_input",
      "input_purpose": "conflict_resolution",
      "display": "等待冲突裁决",
      "next_states": {
        "resolve": "CODING",
        "needs_spec_change": "PLANNING_SPECS",
        "needs_architecture_change": "PLANNING_ARCHITECTURE"
      }
    },
    "TESTING": {
      "type": "agent_execution",
      "agent": "tester",
      "display": "测试中",
      "next_states": {
        "complete": "REVIEW",
        "fail": "CODING",
        "fail_max_retries": "FAILED"
      }
    },
    "REVIEW": {
      "type": "agent_execution",
      "agent": "reviewer",
      "display": "Review 中",
      "next_states": {
        "complete": "ACCEPTANCE_PENDING",
        "fail": "CODING",
        "fail_max_retries": "FAILED"
      }
    },
    "ACCEPTANCE_PENDING": {
      "type": "human_confirmation",
      "display": "等待验收",
      "next_states": {
        "confirm": "MERGING",
        "reject": "CODING",
        "reject_to_requirements": "PLANNING_REQUIREMENTS",
        "reject_to_architecture": "PLANNING_ARCHITECTURE",
        "reject_to_specs": "PLANNING_SPECS"
      }
    },
    "MERGING": {
      "type": "system_action",
      "action": "git_commit_push",
      "display": "提交代码中",
      "next_states": {
        "complete": "COMPLETED",
        "fail": "FAILED"
      }
    },
    "COMPLETED": {
      "type": "terminal",
      "success": true,
      "display": "已完成"
    },
    "FAILED": {
      "type": "terminal",
      "success": false,
      "display": "失败"
    },
    "CANCELLED": {
      "type": "terminal",
      "success": false,
      "display": "已取消"
    },
    "PAUSED": {
      "type": "idle",
      "display": "已暂停",
      "next_states": {
        "resume": "<previous_state>"
      }
    }
  }
}
