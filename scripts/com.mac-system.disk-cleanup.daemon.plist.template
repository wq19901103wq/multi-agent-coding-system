<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mac-system.disk-cleanup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>exec "__PROJECT_ROOT__/scripts/disk_cleanup.sh"</string>
    </array>
    <key>UserName</key>
    <string>__USERNAME__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>DISK_CLEANUP_HOME</key>
        <string>__USER_HOME__</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/disk_cleanup.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/disk_cleanup.log</string>
</dict>
</plist>
