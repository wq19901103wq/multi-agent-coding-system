<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mac-system.watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>exec "__PROJECT_ROOT__/scripts/run_watchdog.sh"</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>ExitTimeOut</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/server_watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/server_watchdog.log</string>
</dict>
</plist>
