{
  "version": "1.0",
  "task_type": "iteration",
  "description": "已有仓库中范围明确、风险受控的增量迭代快速流程",
  "stages": [
    {
      "id": "coding",
      "kind": "implementation",
      "execution_state": "CODING",
      "agent": "coder",
      "display": "增量编码中",
      "inputs": [
        {
          "state": "CLARIFICATION_PENDING",
          "display": "等待澄清",
          "default": true,
          "event": "clarify",
          "return_events": {"answer": "$stage:coding"}
        },
        {
          "state": "CONFLICT_PENDING",
          "display": "等待冲突裁决",
          "purpose": "conflict_resolution",
          "event": "conflict",
          "return_events": {"resolve": "$stage:coding"}
        }
      ],
      "confirmation": {"state": "CODING_CONFIRM_PENDING", "display": "等待确认编码结果"}
    },
    {
      "id": "testing",
      "kind": "quality",
      "execution_state": "TESTING",
      "agent": "tester",
      "display": "增量测试中",
      "inputs": [{"state": "TESTING_INPUT_PENDING", "display": "等待测试澄清", "default": true}],
      "confirmation": {"state": "TESTING_CONFIRM_PENDING", "display": "等待确认测试结果"}
    },
    {
      "id": "review",
      "kind": "quality",
      "execution_state": "REVIEW",
      "agent": "reviewer",
      "display": "增量 Review 中",
      "inputs": [{"state": "REVIEW_INPUT_PENDING", "display": "等待 Review 澄清", "default": true}],
      "confirmation": {"state": "REVIEW_CONFIRM_PENDING", "display": "等待确认 Review 结果"}
    }
  ],
  "rework_targets": [
    {"action": "to_coding", "label": "直接重新编码", "target_stage": "coding"},
    {"action": "to_testing", "label": "直接重新测试", "target_stage": "testing"}
  ],
  "acceptance_targets": [
    {"action": "reject_to_coding", "label": "驳回到编码", "target_stage": "coding"}
  ]
}
