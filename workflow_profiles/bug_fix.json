{
  "version": "1.0",
  "task_type": "bug_fix",
  "description": "Bug 修复流程",
  "stages": [
    {
      "id": "analysis", "kind": "planning", "execution_state": "BUG_ANALYSIS", "agent": "planner", "stage": "bug_analysis", "display": "Bug 分析中",
      "inputs": [{"state": "BUG_FIX_INPUT_PENDING", "display": "等待 Bug 分析澄清", "default": true}],
      "confirmation": {"state": "BUG_FIX_CONFIRM_PENDING", "display": "等待确认修复方案", "subject": "修复方案"}
    },
    {
      "id": "coding", "kind": "implementation", "execution_state": "CODING", "agent": "coder", "display": "修复代码中",
      "inputs": [
        {"state": "CLARIFICATION_PENDING", "display": "等待澄清", "default": true, "event": "clarify", "return_events": {"answer": "$stage:coding", "needs_bug_analysis_change": "$stage:analysis"}},
        {"state": "CONFLICT_PENDING", "display": "等待冲突裁决", "purpose": "conflict_resolution", "event": "conflict", "return_events": {"resolve": "$stage:coding", "needs_bug_analysis_change": "$stage:analysis"}}
      ],
      "routes": {"bug_analysis_question": "$stage:analysis"},
      "confirmation": {"state": "CODING_CONFIRM_PENDING", "display": "等待确认修复代码"}
    },
    {
      "id": "testing", "kind": "quality", "execution_state": "TESTING", "agent": "tester", "display": "测试中",
      "inputs": [{"state": "TESTING_INPUT_PENDING", "display": "等待测试澄清", "default": true}],
      "confirmation": {"state": "TESTING_CONFIRM_PENDING", "display": "等待确认测试结果"}
    },
    {
      "id": "review", "kind": "quality", "execution_state": "REVIEW", "agent": "reviewer", "display": "Review 中",
      "inputs": [{"state": "REVIEW_INPUT_PENDING", "display": "等待 Review 澄清", "default": true}],
      "confirmation": {"state": "REVIEW_CONFIRM_PENDING", "display": "等待确认 Review 结果"}
    }
  ],
  "rework_targets": [
    {"action": "to_analysis", "label": "重新分析 Bug", "target_stage": "analysis"},
    {"action": "to_coding", "label": "直接重新编码", "target_stage": "coding"},
    {"action": "to_testing", "label": "直接重新测试", "target_stage": "testing"}
  ],
  "acceptance_targets": [
    {"action": "reject_to_analysis", "label": "驳回到分析", "target_stage": "analysis"}
  ]
}
