{
  "version": "1.0",
  "task_type": "documentation",
  "description": "文档编写/更新流程",
  "stages": [
    {
      "id": "outline", "kind": "planning", "execution_state": "DOC_OUTLINE", "agent": "documentation_planner", "stage": "doc_outline", "display": "大纲设计中",
      "inputs": [{"state": "OUTLINE_INPUT_PENDING", "display": "等待大纲澄清", "default": true}],
      "confirmation": {"state": "OUTLINE_CONFIRM_PENDING", "display": "等待确认大纲", "subject": "文档大纲"}
    },
    {
      "id": "coding", "kind": "implementation", "execution_state": "CODING", "agent": "coder", "display": "文档编写中",
      "inputs": [
        {"state": "CLARIFICATION_PENDING", "display": "等待澄清", "default": true, "event": "clarify", "return_events": {"answer": "$stage:coding", "needs_outline_change": "$stage:outline"}},
        {"state": "CONFLICT_PENDING", "display": "等待冲突裁决", "purpose": "conflict_resolution", "event": "conflict", "return_events": {"resolve": "$stage:coding", "needs_outline_change": "$stage:outline"}}
      ],
      "routes": {"outline_question": "$stage:outline"},
      "confirmation": {"state": "CODING_CONFIRM_PENDING", "display": "等待确认文档内容"}
    },
    {
      "id": "review", "kind": "quality", "execution_state": "REVIEW", "agent": "reviewer", "display": "Review 中",
      "inputs": [{"state": "REVIEW_INPUT_PENDING", "display": "等待 Review 澄清", "default": true}],
      "confirmation": {"state": "REVIEW_CONFIRM_PENDING", "display": "等待确认 Review 结果"}
    }
  ],
  "rework_targets": [
    {"action": "to_outline", "label": "重新梳理大纲", "target_stage": "outline"},
    {"action": "to_coding", "label": "直接重新编写", "target_stage": "coding"}
  ],
  "acceptance_targets": [
    {"action": "reject_to_outline", "label": "驳回到大纲", "target_stage": "outline"}
  ]
}
