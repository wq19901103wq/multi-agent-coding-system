# Claude Code / Anthropic provider
# When using a 3rd-party Anthropic-compatible provider (e.g. DeepSeek),
# set ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN (or ANTHROPIC_API_KEY).
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-pro
CLAUDE_CODE_EFFORT_LEVEL=high
API_TIMEOUT_MS=600000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Claude Code CLI binary path
CLAUDE_BIN=claude

# Feishu/Lark Bot
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Feishu/Lark simulator bot used by scripts/feishu_e2e.py
FEISHU_SIMULATOR_APP_ID=
FEISHU_SIMULATOR_APP_SECRET=
FEISHU_SIMULATOR_CHAT_ID=

# Enable test-only endpoints (e.g. /test/inject_card_action, /test/tick)
FEISHU_TEST_MODE=false

# Server
MCS_HOST=0.0.0.0
MCS_PORT=18080
MCS_LOG_LEVEL=info

# Database
DATABASE_URL=sqlite:///./mac_system.db

# Git
GIT_DEFAULT_BRANCH=main
GIT_AUTHOR_NAME="MAC System"
GIT_AUTHOR_EMAIL=mac-system@local

# Paths
PROJECTS_DIR=./projects
STATE_MACHINES_DIR=./state_machines
AGENT_CONFIG_PATH=./agent_config.json
# Comma-separated absolute roots allowed for /bind and API bound_directory.
# Empty is fail-closed: host-directory binding is disabled.
MAC_ALLOWED_BIND_ROOTS=

# Agent Defaults
AGENT_TIMEOUT_SECONDS=600
MAX_AGENT_RETRIES=3

# Approval
DEFAULT_APPROVAL_MODE=normal

# Admin panel (optional). When set, /admin/projects and admin actions require
# the ?token=... query parameter to match this value.
ADMIN_TOKEN=
# Required for REST control-plane endpoints (/projects and /test).
# Generate a strong random value; requests use Authorization: Bearer <token>.
CONTROL_API_TOKEN=
