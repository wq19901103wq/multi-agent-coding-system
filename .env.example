# Claude Code / Anthropic
# Claude Code CLI uses its own auth, but API key is needed for some operations
ANTHROPIC_API_KEY=

# Feishu/Lark Bot
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Server
MCS_HOST=0.0.0.0
MCS_PORT=8000
MCS_LOG_LEVEL=info

# Database
DATABASE_URL=sqlite:///./mac_system.db

# Git
GIT_DEFAULT_BRANCH=main
GIT_AUTHOR_NAME="MAC System"
GIT_AUTHOR_EMAIL="mac-system@local"

# Paths
PROJECTS_ROOT=./projects
STATE_MACHINES_DIR=./state_machines
PROMPTS_DIR=./prompts
SCHEMAS_DIR=./schemas
SKILLS_DIR=./skills

# Agent Defaults
DEFAULT_AGENT_RUNTIME=claude
DEFAULT_CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_CODE_TIMEOUT=600

# Approval
DEFAULT_APPROVAL_MODE=normal
