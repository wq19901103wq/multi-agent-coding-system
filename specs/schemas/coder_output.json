{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/coder_output.json",
  "title": "Coder Output",
  "type": "object",
  "required": ["success", "next_state_event"],
  "additionalProperties": false,
  "properties": {
    "success": {"const": true},
    "next_state_event": {"enum": ["complete", "fail", "ask_user", "clarify", "conflict"]},
    "question_batch": {"$ref": "agent_question_batch.json"},
    "modified_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"enum": ["file", "directory"]},
          "manifest_path": {"type": "string"},
          "description": {"type": "string"}
        },
        "allOf": [{
          "if": {
            "required": ["kind"],
            "properties": {"kind": {"const": "directory"}}
          },
          "then": {"required": ["manifest_path"]}
        }]
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "addressed_feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feedback_id", "status", "explanation"],
        "additionalProperties": false,
        "properties": {
          "feedback_id": {"type": "string"},
          "status": {"enum": ["fixed", "partially_fixed", "disputed", "not_applicable"]},
          "explanation": {"type": "string"},
          "files": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "clarification_question": {"type": "string"},
    "conflict": {
      "type": "object",
      "required": ["topic"],
      "properties": {
        "topic": {"type": "string"},
        "sides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "argument"],
            "properties": {
              "label": {"type": "string"},
              "argument": {"type": "string"}
            }
          }
        }
      }
    },
    "request_rollback_to": {"type": "string"},
    "completion_reason": {"type": "string", "minLength": 1},
    "blockers": {"type": "array", "items": {"$ref": "resolution_request.json"}},
    "completion_evidence": {"type": "array", "items": {"type": "string"}},
    "deferred_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary", "owner_stage", "allowed_by_contract"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"}, "summary": {"type": "string"},
          "owner_stage": {"type": "string"}, "allowed_by_contract": {"const": true}
        }
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"next_state_event": {"const": "ask_user"}}},
    "then": {
      "required": ["question_batch", "blockers", "completion_reason"],
      "properties": {
        "completion_reason": {"const": "resolution_requested"},
        "blockers": {"minItems": 1}
      }
    },
    "else": {"not": {"required": ["question_batch"]}}
  }, {
    "if": {"properties": {"next_state_event": {"const": "complete"}}},
    "then": {"properties": {"blockers": {"maxItems": 0}}}
  }]
}
