{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/coder_output.json",
  "title": "Coder Output",
  "type": "object",
  "required": ["success", "next_state_event"],
  "additionalProperties": false,
  "properties": {
    "success": {"type": "boolean"},
    "next_state_event": {"type": "string"},
    "modified_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "clarification_question": {"type": "string"},
    "conflict": {
      "type": "object",
      "required": ["topic"],
      "properties": {
        "topic": {"type": "string"},
        "sides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "argument"],
            "properties": {
              "label": {"type": "string"},
              "argument": {"type": "string"}
            }
          }
        }
      }
    },
    "request_rollback_to": {"type": "string"}
  }
}
