{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/coder_output.json",
  "title": "Coder Output",
  "type": "object",
  "required": ["success", "next_state_event"],
  "additionalProperties": false,
  "properties": {
    "success": {"type": "boolean"},
    "next_state_event": {"enum": ["complete", "fail", "ask_user", "clarify", "conflict"]},
    "question_batch": {"$ref": "agent_question_batch.json"},
    "modified_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "addressed_feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feedback_id", "status", "explanation"],
        "additionalProperties": false,
        "properties": {
          "feedback_id": {"type": "string"},
          "status": {"enum": ["fixed", "partially_fixed", "disputed", "not_applicable"]},
          "explanation": {"type": "string"},
          "files": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "clarification_question": {"type": "string"},
    "conflict": {
      "type": "object",
      "required": ["topic"],
      "properties": {
        "topic": {"type": "string"},
        "sides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "argument"],
            "properties": {
              "label": {"type": "string"},
              "argument": {"type": "string"}
            }
          }
        }
      }
    },
    "request_rollback_to": {"type": "string"}
  },
  "allOf": [{
    "if": {"properties": {"next_state_event": {"const": "ask_user"}}},
    "then": {"required": ["question_batch"]},
    "else": {"not": {"required": ["question_batch"]}}
  }]
}
