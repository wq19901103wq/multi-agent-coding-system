{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/agent_question_batch.json",
  "title": "Agent Question Batch",
  "type": "object",
  "required": ["batch_key", "questions"],
  "additionalProperties": false,
  "properties": {
    "batch_key": {"type": "string", "minLength": 1},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question_id", "kind", "question", "reason", "allow_free_text", "options", "affected_trace_ids"],
        "additionalProperties": false,
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "decision_key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
          },
          "parent_question_id": {"type": ["string", "null"]},
          "kind": {"enum": ["blocking", "decision", "non_blocking"]},
          "question": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "allow_free_text": {"type": "boolean"},
          "options": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["key", "label", "impact", "recommended"],
              "additionalProperties": false,
              "properties": {
                "key": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "impact": {"type": "string"},
                "recommended": {"type": "boolean"},
                "triggers_free_text": {
                  "type": "boolean",
                  "description": "Set to true on the option that means 'I want to describe my own answer'. When the user selects it, the handler collects free-text input instead of submitting the option as the final answer. Required on the non-recommended option of any allow_free_text choice question."
                },
                "grants_runtime_capabilities": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"enum": ["HostAutomation"]},
                  "description": "Explicit machine-readable capabilities granted when this option is submitted. Labels and option keys are never interpreted as permission."
                }
              }
            }
          },
          "multiple": {"type": "boolean", "default": false},
          "default_assumption": {"type": ["string", "null"]},
          "affected_trace_ids": {"type": "array", "items": {"type": "string"}}
          ,
          "sensitivity": {"enum": ["public", "internal", "secret"], "default": "internal"},
          "secret_env_var": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"enum": ["blocking", "decision"]}}},
            "then": {
              "required": ["decision_key"],
              "anyOf": [{"properties": {"options": {"minItems": 1}}}, {"properties": {"allow_free_text": {"const": true}}}]
            }
          },
          {
            "if": {
              "required": ["sensitivity"],
              "properties": {"sensitivity": {"const": "secret"}}
            },
            "then": {
              "required": ["secret_env_var"],
              "properties": {
                "allow_free_text": {"const": true},
                "options": {"maxItems": 0}
              }
            }
          }
        ]
      }
    }
  }
}
