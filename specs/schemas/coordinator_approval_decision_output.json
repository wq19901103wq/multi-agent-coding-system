{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/coordinator_approval_decision_output.json",
  "title": "Coordinator Approval Decision Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["success", "action", "reason", "evidence_refs"],
  "properties": {
    "success": {"type": "boolean"},
    "action": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
