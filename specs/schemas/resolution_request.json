{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/resolution_request.json",
  "title": "Resolution Request",
  "type": "object",
  "required": ["id", "category", "summary", "evidence", "required_resolution", "preferred_resolver", "blocking"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "category": {
      "enum": [
        "missing_information", "ambiguous_requirement", "missing_capability",
        "permission_required", "dependency_unavailable", "spec_conflict",
        "environment_failure", "external_failure", "scope_decision", "quality_failure"
      ]
    },
    "code": {"type": "string"},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "required_resolution": {"type": "string", "minLength": 1},
    "preferred_resolver": {"enum": ["coordinator", "system", "runtime", "user"]},
    "sensitivity": {"enum": ["public", "internal", "secret_ref"], "default": "internal"},
    "blocking": {"const": true},
    "affected_acceptance_criterion_ids": {"type": "array", "items": {"type": "string"}},
    "affected_feedback_ids": {"type": "array", "items": {"type": "string"}}
  }
}
