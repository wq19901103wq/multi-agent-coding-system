{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/project_manager_output.json",
  "title": "Project Manager Output",
  "type": "object",
  "required": ["success", "reply"],
  "additionalProperties": false,
  "properties": {
    "success": {"type": "boolean"},
    "next_state_event": {"type": "string"},
    "reply": {"type": "string"},
    "suggested_action": {
      "enum": [
        "none",
        "confirm",
        "reject",
        "answer",
        "continue",
        "rollback_to_requirements",
        "rollback_to_architecture",
        "rollback_to_specs",
        "rollback_to_coding",
        "rollback_to_analysis",
        "rollback_to_outline",
        "escalate_to_human"
      ]
    },
    "clarification_answer": {"type": "string"},
    "updated_summary": {"type": "string"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
