{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/acceptance_agent_output.json",
  "title": "Acceptance Agent Output",
  "type": "object",
  "required": ["success", "result", "summary", "criteria", "user_input_requests", "environment"],
  "additionalProperties": false,
  "properties": {
    "success": {"const": true},
    "result": {"enum": ["pass", "fail", "needs_user"]},
    "summary": {"type": "string", "minLength": 1},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["acceptance_criterion_id", "evidence_source", "result", "method", "expected", "actual", "evidence", "limitations"],
        "additionalProperties": false,
        "properties": {
          "acceptance_criterion_id": {"type": "string"},
          "evidence_source": {"enum": ["system_observable", "user_preference", "authorization", "external_fact"]},
          "result": {"enum": ["pass", "fail", "needs_user", "blocked"]},
          "method": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "actual": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "user_input_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["acceptance_criterion_id", "category", "question", "reason", "options"],
        "additionalProperties": false,
        "properties": {
          "acceptance_criterion_id": {"type": "string"},
          "category": {"enum": ["user_preference", "authorization", "external_fact"]},
          "question": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "label", "impact", "recommended"],
              "additionalProperties": false,
              "properties": {
                "key": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "impact": {"type": "string", "minLength": 1},
                "recommended": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["entry_points", "started_services", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "entry_points": {"type": "array", "items": {"type": "string"}},
        "started_services": {"type": "array", "items": {"type": "string"}},
        "artifacts": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
