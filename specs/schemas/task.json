{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/task.json",
  "title": "TASK.json",
  "type": "object",
  "required": ["version", "task_id", "agent_type", "state", "input", "output"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {"type": "string"},
    "agent_type": {
      "enum": ["planner", "coder", "tester", "reviewer", "acceptance_evaluator", "project_manager"]
    },
    "state": {"type": "string"},
    "input": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": true,
      "properties": {
        "description": {"type": "string"},
        "spec_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "context_files": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "coder_output.json"},
        {"$ref": "tester_output.json"},
        {"$ref": "reviewer_output.json"},
        {"$ref": "acceptance_evaluator_output.json"},
        {"$ref": "project_manager_output.json"}
      ]
    }
  }
}
