{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/requirements.json",
  "title": "REQUIREMENTS.json",
  "type": "object",
  "required": ["summary", "goals", "acceptance_criteria"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string"},
    "goals": {
      "type": "array",
      "items": {"type": "string"}
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question"],
        "additionalProperties": false,
        "properties": {
          "question": {"type": "string"},
          "impact": {"type": "string"},
          "default_assumption": {"type": "string"}
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {"type": "string"}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "out_of_scope": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
