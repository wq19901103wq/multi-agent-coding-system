{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/coordinator_input_resolution_output.json",
  "title": "Coordinator Input Resolution Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["success", "disposition", "reason", "evidence_refs"],
  "properties": {
    "success": {"type": "boolean"},
    "disposition": {"enum": ["answered", "ask_user"]},
    "answer": {"type": "string"},
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "answered"}}},
      "then": {
        "required": ["answer"],
        "properties": {
          "answer": {"minLength": 1},
          "evidence_refs": {"minItems": 1}
        }
      }
    }
  ]
}
