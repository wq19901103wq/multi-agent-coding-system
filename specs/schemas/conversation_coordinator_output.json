{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/conversation_coordinator_output.json",
  "title": "Conversation Coordinator Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "reply",
    "intent",
    "effect",
    "commitment",
    "needs_clarification",
    "proposed_action"
  ],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "reply": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "enum": [
        "inspect",
        "diagnose",
        "research",
        "discuss",
        "compare",
        "evaluate",
        "explain",
        "recommend_next",
        "summarize",
        "draft",
        "status_query",
        "provide_information",
        "provide_feedback",
        "correct",
        "change_scope",
        "authorize_execution",
        "approve",
        "reject",
        "select_option",
        "pause",
        "resume",
        "cancel",
        "switch_context",
        "meta_instruction",
        "unknown"
      ]
    },
    "effect": {
      "enum": [
        "none",
        "read_only",
        "local_diagnostics",
        "conversation_write",
        "workspace_write",
        "workflow_control",
        "external_effect"
      ]
    },
    "commitment": {
      "enum": [
        "exploring",
        "considering",
        "preferred",
        "authorized",
        "ambiguous"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "conversation",
            "repository",
            "project",
            "approval",
            "pending_action",
            "latest_artifact",
            "current_stage"
          ]
        },
        "id": {
          "type": "string"
        },
        "name_hint": {
          "type": "string"
        }
      }
    },
    "needs_clarification": {
      "type": "boolean"
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "options", "allow_free_text"],
      "properties": {
        "subject_key": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label"],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "recommended": {
                "type": "boolean"
              },
              "triggers_free_text": {
                "type": "boolean",
                "description": "Set to true on the option that means 'I want to describe my own answer'. The handler will collect free-text input instead of treating the option as the final answer."
              }
            }
          }
        },
        "allow_free_text": {
          "type": "boolean"
        }
      }
    },
    "proposed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "none",
            "answer",
            "request_context",
            "inspect_workspace",
            "research",
            "query_status",
            "create_draft",
            "request_clarification",
            "propose_start_delivery",
            "start_delivery",
            "resolve_pending_action",
            "propose_project_control",
            "propose_approval_resolution",
            "resend_approval",
            "route_project_input",
            "view_artifact"
          ]
        },
        "artifact_kind": {
          "enum": ["requirements", "architecture", "specs"]
        },
        "repository_path": {
          "type": "string",
          "minLength": 1,
          "description": "Exact authorized repository root requested for a bounded read-only context pass."
        },
        "context_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["workspace_read", "capability_metadata"]
          }
        },
        "read_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "description": "Small evidence plan relative to repository_path; it is advisory and does not widen permissions."
        },
        "task_type": {
          "enum": ["feature", "iteration", "bug_fix", "documentation"]
        },
        "base_project_id": {
          "type": "string",
          "minLength": 1,
          "description": "Terminal project whose existing workspace must be reused for a follow-up delivery. Omit for a new independent delivery."
        },
        "reference_mode": {
          "enum": ["none", "full"],
          "description": "Set to full when the requested delivery must preserve the complete product behavior of a reference repository. This semantic decision is made by the Coordinator, never by Handler keyword matching."
        },
        "description": {
          "type": "string"
        },
        "control_action": {
          "enum": ["pause", "resume", "cancel", "rollback"]
        },
        "target_stage": {
          "enum": ["requirements", "architecture", "specs", "coding", "testing", "acceptance"]
        },
        "question_id": {
          "type": "string",
          "minLength": 1,
          "description": "Exact pending input question to answer, or an answered question to correct."
        },
        "pending_action_id": {
          "type": "string",
          "minLength": 1,
          "description": "Pending clarification resolved atomically by this project-input action."
        },
        "pending_option_key": {
          "type": "string",
          "minLength": 1,
          "description": "Exact option selected from pending_action_id when the same message also supplies the details needed to continue."
        },
        "approval_decision": {
          "enum": ["confirm", "reject", "select_option"]
        },
        "option_key": {
          "type": "string"
        },
        "feedback": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "repository_read",
              "local_diagnostics",
              "workspace_write",
              "git_write",
              "external_research",
              "deployment",
              "destructive_operation"
            ]
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delivery_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["risk_level", "change_surface", "required_stages", "reason"],
          "properties": {
            "risk_level": {"enum": ["low", "medium", "high"]},
            "change_surface": {
              "enum": ["user_visible", "internal", "documentation", "mixed"]
            },
            "required_stages": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "coding",
                  "testing",
                  "review",
                  "acceptance",
                  "acceptance_evaluator"
                ]
              }
            },
            "reason": {"type": "string", "minLength": 1}
          },
          "description": "Semantic risk/evidence request. Deterministic policy adds mandatory stages and never routes from prose keywords."
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "question", "answer", "status"],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
              },
              "question": {"type": "string", "minLength": 1},
              "answer": {"type": "string", "minLength": 1},
              "status": {"const": "confirmed"},
              "details": {"type": "object"}
            }
          }
        },
        "capability_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_file", "env_bindings"],
            "properties": {
              "source_file": {"type": "string", "minLength": 1},
              "env_bindings": {
                "type": "object",
                "minProperties": 1,
                "description": "Mapping from TARGET process environment variable name to SOURCE variable name in source_file.",
                "additionalProperties": {"type": "string", "minLength": 1}
              },
              "description": {"type": "string"},
              "affected_trace_ids": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "description": "Current AC or feedback IDs that require this capability."
              }
            }
          }
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_read", "summary", "findings"],
      "properties": {
        "files_read": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "summary": {"type": "string", "minLength": 1},
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "evidence"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "evidence": {"type": "string", "minLength": 1},
              "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
              "recommendation": {"type": "string"}
            }
          }
        }
      }
    },
    "updated_summary": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "proposed_action": {
            "properties": {"type": {"const": "request_context"}}
          }
        }
      },
      "then": {
        "properties": {
          "proposed_action": {
            "required": [
              "repository_path",
              "context_capabilities",
              "read_targets"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "needs_clarification": {
            "const": true
          }
        }
      },
      "then": {
        "required": ["clarification"]
      }
    },
    {
      "if": {
        "properties": {
          "proposed_action": {
            "properties": {
              "type": {
                "enum": ["propose_start_delivery", "start_delivery"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "proposed_action": {
            "required": [
              "task_type",
              "description",
              "reference_mode",
              "scope",
              "permissions",
              "acceptance_criteria"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposed_action": {
            "properties": {"type": {"const": "inspect_workspace"}},
            "required": ["type"]
          }
        },
        "required": ["proposed_action"]
      },
      "then": {"required": ["inspection"]}
    },
    {
      "if": {
        "properties": {
          "proposed_action": {
            "properties": {"type": {"const": "propose_project_control"}},
            "required": ["type"]
          }
        },
        "required": ["proposed_action"]
      },
      "then": {
        "properties": {"proposed_action": {"required": ["control_action"]}}
      }
    },
    {
      "if": {
        "properties": {
          "proposed_action": {
            "properties": {"type": {"const": "propose_approval_resolution"}},
            "required": ["type"]
          }
        },
        "required": ["proposed_action"]
      },
      "then": {
        "required": ["target"],
        "properties": {"proposed_action": {"required": ["approval_decision"]}}
      }
    },
    {
      "if": {
        "properties": {
          "proposed_action": {
            "properties": {"type": {"const": "resolve_pending_action"}},
            "required": ["type"]
          }
        },
        "required": ["proposed_action"]
      },
      "then": {"required": ["target"]}
    },
    {
      "if": {
        "properties": {
          "proposed_action": {
            "properties": {"type": {"const": "view_artifact"}},
            "required": ["type"]
          }
        },
        "required": ["proposed_action"]
      },
      "then": {
        "properties": {"proposed_action": {"required": ["artifact_kind"]}}
      }
    }
  ]
}
