{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/reviewer_output.json",
  "title": "Reviewer Output",
  "type": "object",
  "required": ["success", "next_state_event"],
  "additionalProperties": false,
  "properties": {
    "success": {"const": true},
    "next_state_event": {"enum": ["complete", "fail", "ask_user"]},
    "question_batch": {"$ref": "agent_question_batch.json"},
    "result": {"enum": ["pass", "fail"]},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "description", "blocking", "category"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["minor", "major", "critical"]},
          "category": {"enum": ["requirements", "architecture", "spec", "implementation", "tests", "security", "maintainability"]},
          "blocking": {"type": "boolean"},
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "description": {"type": "string"},
          "recommendation": {"type": "string"}
        }
      }
    },
    "recommended_rework_target": {
      "enum": ["none", "requirements", "architecture", "specs", "coding", "testing"]
    },
    "verified_feedback_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "requirement_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["acceptance_criterion_id", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "acceptance_criterion_id": {"type": "string"},
          "status": {"enum": ["covered", "partially_covered", "not_covered", "violated"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "stale_artifact_ids": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "completion_reason": {"type": "string", "minLength": 1},
    "blockers": {"type": "array", "items": {"$ref": "resolution_request.json"}},
    "completion_evidence": {"type": "array", "items": {"type": "string"}},
    "deferred_obligations": {"type": "array", "items": {"type": "object"}}
  },
  "allOf": [{
    "if": {"properties": {"next_state_event": {"const": "ask_user"}}},
    "then": {
      "required": ["question_batch", "blockers", "completion_reason"],
      "properties": {
        "completion_reason": {"const": "resolution_requested"},
        "blockers": {"minItems": 1}
      }
    },
    "else": {
      "required": ["result"],
      "not": {"required": ["question_batch"]}
    }
  }, {
    "if": {"properties": {"next_state_event": {"const": "complete"}}},
    "then": {"properties": {"blockers": {"maxItems": 0}}}
  }]
}
