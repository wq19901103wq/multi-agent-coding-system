{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/doc_outline.json",
  "title": "DOC_OUTLINE.json",
  "type": "object",
  "required": ["summary", "sections", "affected_files"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "assigned_agent": {"enum": ["coder", "reviewer"]}
        }
      }
    },
    "target_audience": {"type": "string"},
    "tone": {"type": "string"},
    "affected_files": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
