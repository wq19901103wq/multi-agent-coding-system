{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/bug_analysis.json",
  "title": "BUG_ANALYSIS.json",
  "type": "object",
  "required": ["artifact_id", "version", "round", "status", "summary", "root_cause", "fix_strategy", "affected_files", "acceptance_criteria"],
  "additionalProperties": false,
  "properties": {
    "artifact_id": {"const": "bug_analysis"},
    "version": {"type": "integer", "minimum": 1},
    "round": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "pending_confirmation", "confirmed", "stale"]},
    "summary": {"type": "string"},
    "root_cause": {"type": "string"},
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string"},
        "expected": {"type": "string"},
        "actual": {"type": "string"}
      }
    },
    "fix_strategy": {"type": "string"},
    "affected_files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "verification_method", "evidence_source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "verification_method": {"enum": ["automated_test", "integration_test", "e2e", "manual", "inspection", "metric"]},
          "evidence_source": {"enum": ["system_observable", "user_preference", "authorization", "external_fact"]},
          "evidence_required": {"type": "string"}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
