{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/coordinator_failure_recovery_output.json",
  "title": "Coordinator Failure Recovery Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["success", "disposition", "summary", "reason"],
  "properties": {
    "success": {"type": "boolean"},
    "disposition": {
      "enum": ["retry_agent", "rework", "ask_user"]
    },
    "summary": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "resolution_instruction": {"type": "string"},
    "target_stage": {
      "enum": ["requirements", "architecture", "specs", "coding", "testing"]
    },
    "user_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "options", "allow_free_text"],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "description"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "description": {"type": "string"},
              "recommended": {"type": "boolean"},
              "triggers_free_text": {"type": "boolean"}
            }
          }
        },
        "allow_free_text": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "retry_agent"}}},
      "then": {
        "required": ["resolution_instruction"],
        "properties": {"resolution_instruction": {"minLength": 1}}
      }
    },
    {
      "if": {"properties": {"disposition": {"const": "rework"}}},
      "then": {"required": ["target_stage"]}
    },
    {
      "if": {"properties": {"disposition": {"const": "ask_user"}}},
      "then": {"required": ["user_question"]}
    }
  ]
}
