{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/coordinator_agent_clarification_output.json",
  "title": "Coordinator Agent Clarification Output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "success": {"type": "boolean"},
    "summary": {"type": "string"},
    "batch_key": {"type": "string"},
    "resolutions": {
      "type": "array",
      "items": {"$ref": "#/definitions/canonicalResolution"}
    },
    "responses": {
      "type": "array",
      "items": {"$ref": "#/definitions/compatibleResolution"}
    },
    "clarifications": {
      "type": "array",
      "items": {"$ref": "#/definitions/compatibleClarification"}
    }
  },
  "oneOf": [
    {
      "required": ["success", "resolutions", "summary"],
      "not": {"anyOf": [{"required": ["responses"]}, {"required": ["clarifications"]}]}
    },
    {
      "required": ["responses"],
      "not": {"anyOf": [{"required": ["resolutions"]}, {"required": ["clarifications"]}]}
    },
    {
      "required": ["clarifications"],
      "not": {"anyOf": [{"required": ["resolutions"]}, {"required": ["responses"]}]}
    }
  ],
  "definitions": {
    "userOptions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "impact", "recommended"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "impact": {"type": "string"},
          "recommended": {"type": "boolean"},
          "triggers_free_text": {"type": "boolean"},
          "grants_runtime_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["HostAutomation"]},
            "description": "Exact machine-readable permission metadata copied from the requesting Agent option. Never infer this field from wording."
          }
        }
      }
    },
    "sourceFactIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "canonicalResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "status", "reason", "source_fact_ids"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["answered", "retry_agent", "route_upstream", "ask_user"]},
        "answer": {"type": "string"},
        "answer_label": {"type": "string"},
        "reason": {"type": "string"},
        "resolution_instruction": {"type": "string"},
        "route_target_stage": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "question": {"type": "string"},
        "options": {"$ref": "#/definitions/userOptions"},
        "allow_free_text": {"type": "boolean"},
        "source_fact_ids": {"$ref": "#/definitions/sourceFactIds"}
      },
      "allOf": [{"$ref": "#/definitions/answeredRequirements"}, {"$ref": "#/definitions/routeRequirements"}]
    },
    "compatibleResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "status", "reason"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["answered", "retry_agent", "route_upstream", "ask_user"]},
        "answer": {"type": "string"},
        "answer_label": {"type": "string"},
        "reason": {"type": "string"},
        "resolution_instruction": {"type": "string"},
        "route_target_stage": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "source_fact_ids": {"$ref": "#/definitions/sourceFactIds"},
        "question": {"type": "string"},
        "options": {"$ref": "#/definitions/userOptions"},
        "allow_free_text": {"type": "boolean"}
      },
      "allOf": [{"$ref": "#/definitions/answeredRequirements"}, {"$ref": "#/definitions/routeRequirements"}]
    },
    "compatibleClarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "disposition", "reason"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["answered", "retry_agent", "route_upstream", "ask_user"]},
        "answer": {"type": "string"},
        "answer_label": {"type": "string"},
        "reason": {"type": "string"},
        "resolution_instruction": {"type": "string"},
        "route_target_stage": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "source_fact_ids": {"$ref": "#/definitions/sourceFactIds"},
        "question": {"type": "string"},
        "options": {"$ref": "#/definitions/userOptions"},
        "allow_free_text": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "answered"}}},
          "then": {
            "required": ["answer", "source_fact_ids"],
            "properties": {
              "answer": {"minLength": 1},
              "source_fact_ids": {"minItems": 1}
            }
          }
        },
        {"$ref": "#/definitions/routeRequirements"}
      ]
    },
    "answeredRequirements": {
      "if": {"properties": {"status": {"const": "answered"}}},
      "then": {
        "required": ["answer", "source_fact_ids"],
        "properties": {
          "answer": {"minLength": 1},
          "source_fact_ids": {"minItems": 1}
        }
      }
    },
    "routeRequirements": {
      "if": {
        "anyOf": [
          {"properties": {"status": {"const": "route_upstream"}}, "required": ["status"]},
          {"properties": {"disposition": {"const": "route_upstream"}}, "required": ["disposition"]}
        ]
      },
      "then": {"required": ["route_target_stage", "resolution_instruction"]}
    }
  }
}
