{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/specs.json",
  "title": "SPECS.json",
  "type": "object",
  "required": ["artifact_id", "version", "round", "status", "specs"],
  "additionalProperties": false,
  "properties": {
    "artifact_id": {"const": "specs"},
    "version": {"type": "integer", "minimum": 1},
    "round": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "pending_confirmation", "confirmed", "stale", "superseded", "rejected"]},
    "based_on_architecture_version": {"type": "integer", "minimum": 1},
    "content_hash": {"type": "string"},
    "supersedes_round": {"type": ["integer", "null"], "minimum": 1},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "resolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer", "source_input_id"],
        "additionalProperties": false,
        "properties": {
          "question": {"type": "string"},
          "answer": {"type": "string"},
          "source_input_id": {"type": "string"}
        }
      }
    },
    "specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "requirement_ids", "acceptance_criterion_ids", "decision_ids", "acceptance_criteria", "dependencies", "owners", "test_cases", "definition_of_done"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "acceptance_criterion_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "decision_ids": {"type": "array", "items": {"type": "string"}},
          "acceptance_criteria": {
            "type": "array",
            "items": {"type": "string"}
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"}
          },
          "affected_files": {
            "type": "array",
            "items": {"type": "string"}
          },
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "invariants": {"type": "array", "items": {"type": "string"}},
          "interfaces": {"type": "array", "items": {"type": "string"}},
          "data_changes": {"type": "array", "items": {"type": "string"}},
          "algorithm_or_behavior": {"type": "array", "items": {"type": "string"}},
          "error_cases": {"type": "array", "items": {"type": "string"}},
          "security_checks": {"type": "array", "items": {"type": "string"}},
          "migration_steps": {"type": "array", "items": {"type": "string"}},
          "rollback_plan": {"type": "array", "items": {"type": "string"}},
          "observability": {"type": "array", "items": {"type": "string"}},
          "test_cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "type", "scenario", "expected", "acceptance_criterion_ids"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "type": {"enum": ["unit", "integration", "e2e", "manual", "failure_injection"]},
                "scenario": {"type": "string"},
                "expected": {"type": "string"},
                "acceptance_criterion_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          },
          "owners": {
            "type": "object",
            "required": ["implementation", "verification", "review"],
            "additionalProperties": false,
            "properties": {
              "implementation": {"const": "coder"},
              "verification": {"const": "tester"},
              "review": {"const": "reviewer"}
            }
          },
          "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "estimated_effort": {"enum": ["small", "medium", "large"]}
        }
      }
    }
  }
}
