{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/specs.json",
  "title": "SPECS.json",
  "type": "object",
  "required": ["specs"],
  "additionalProperties": false,
  "properties": {
    "specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "acceptance_criteria", "affected_files", "assigned_agent"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "acceptance_criteria": {
            "type": "array",
            "items": {"type": "string"}
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"}
          },
          "affected_files": {
            "type": "array",
            "items": {"type": "string"}
          },
          "assigned_agent": {"enum": ["coder", "tester", "reviewer"]},
          "estimated_effort": {"enum": ["small", "medium", "large"]}
        }
      }
    }
  }
}
