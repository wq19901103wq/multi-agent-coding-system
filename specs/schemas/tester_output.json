{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/tester_output.json",
  "title": "Tester Output",
  "type": "object",
  "required": ["success", "next_state_event", "passed"],
  "additionalProperties": false,
  "properties": {
    "success": {"type": "boolean"},
    "next_state_event": {"type": "string"},
    "passed": {"type": "boolean"},
    "test_files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test": {"type": "string"},
          "error": {"type": "string"}
        }
      }
    },
    "report": {"type": "string"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
