{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/tester_output.json",
  "title": "Tester Output",
  "type": "object",
  "required": ["success", "next_state_event"],
  "additionalProperties": false,
  "properties": {
    "success": {"const": true},
    "next_state_event": {"enum": ["complete", "fail", "ask_user"]},
    "question_batch": {"$ref": "agent_question_batch.json"},
    "passed": {"type": "boolean"},
    "failure_class": {
      "enum": ["none", "implementation_bug", "missing_implementation", "test_bug", "environment_failure", "spec_ambiguity", "architecture_issue", "requirement_mismatch"]
    },
    "recommended_rework_target": {
      "enum": ["none", "requirements", "architecture", "specs", "coding", "testing"]
    },
    "test_files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "test_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "spec_id", "acceptance_criterion_ids", "type", "command_or_method", "result"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "spec_id": {"type": "string"},
          "acceptance_criterion_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "feedback_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "type": {"enum": ["unit", "integration", "e2e", "manual", "inspection", "failure_injection"]},
          "command_or_method": {"type": "string"},
          "expected": {"type": "string"},
          "actual": {"type": "string"},
          "result": {"enum": ["pass", "fail", "unknown", "skipped"]}
        }
      }
    },
    "uncovered_acceptance_criterion_ids": {"type": "array", "items": {"type": "string"}},
    "environment": {"type": "object"},
    "coverage_status": {"enum": ["measured", "not_measured", "not_applicable"]},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "test": {"type": "string"},
          "error": {"type": "string"},
          "expected": {"type": "string"},
          "actual": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "report": {"type": "string"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "verified_feedback_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "completion_reason": {"type": "string", "minLength": 1},
    "blockers": {"type": "array", "items": {"$ref": "resolution_request.json"}},
    "completion_evidence": {"type": "array", "items": {"type": "string"}},
    "deferred_obligations": {"type": "array", "items": {"type": "object"}}
  },
  "allOf": [{
    "if": {"properties": {"next_state_event": {"const": "ask_user"}}},
    "then": {
      "required": ["question_batch", "blockers", "completion_reason"],
      "properties": {
        "completion_reason": {"const": "resolution_requested"},
        "blockers": {"minItems": 1}
      }
    },
    "else": {
      "required": ["passed", "test_evidence"],
      "not": {"required": ["question_batch"]}
    }
  }, {
    "if": {"properties": {"next_state_event": {"const": "complete"}}},
    "then": {"properties": {"blockers": {"maxItems": 0}}}
  }, {
    "if": {"properties": {"next_state_event": {"const": "fail"}}},
    "then": {
      "required": ["passed", "failures"],
      "properties": {
        "passed": {"const": false},
        "failures": {"minItems": 1}
      }
    }
  }]
}
