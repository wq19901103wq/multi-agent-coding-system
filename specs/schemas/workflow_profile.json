{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mac-system.local/schemas/workflow_profile.json",
  "title": "Workflow Profile",
  "type": "object",
  "required": ["version", "task_type", "description", "stages"],
  "properties": {
    "version": {"type": "string"},
    "task_type": {"type": "string"},
    "description": {"type": "string"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "execution_state", "agent", "stage", "display"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["planning", "implementation", "quality"]},
          "execution_state": {"type": "string"},
          "agent": {"type": "string"},
          "stage": {"type": "string"},
          "display": {"type": "string"},
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["state", "display", "default"],
              "properties": {
                "state": {"type": "string"},
                "display": {"type": "string"},
                "default": {"type": "boolean"},
                "event": {"type": "string"},
                "purpose": {"type": "string"},
                "return_events": {"type": "object"}
              }
            }
          },
          "routes": {"type": "object"},
          "confirmation": {
            "type": "object",
            "required": ["state", "display"],
            "properties": {
              "state": {"type": "string"},
              "display": {"type": "string"},
              "subject": {"type": "string"}
            }
          }
        }
      }
    },
    "rework_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "label", "target_stage"],
        "properties": {
          "action": {"type": "string"},
          "label": {"type": "string"},
          "target_stage": {"type": "string"}
        }
      }
    },
    "acceptance_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "label", "target_stage"],
        "properties": {
          "action": {"type": "string"},
          "label": {"type": "string"},
          "target_stage": {"type": "string"}
        }
      }
    }
  }
}
